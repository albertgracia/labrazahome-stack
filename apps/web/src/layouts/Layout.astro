---
export interface Props {
  title?: string;
}

const { title = "Stack 2026" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <nav class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="text-xl font-bold tracking-tight">Stack 2026</a>
        <div class="flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/" class="transition hover:text-gray-900">Home</a>
          <a href="/about" class="transition hover:text-gray-900">About</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="border-t border-gray-200 bg-white py-8">
      <div class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-500 sm:px-6 lg:px-8">
        &copy; {new Date().getFullYear()} Stack 2026. All rights reserved.
      </div>
    </footer>
  </body>
</html>
