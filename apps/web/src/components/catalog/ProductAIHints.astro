---
export interface Props {
  productName: string;
}

const { productName } = Astro.props;
---

<div class="rounded-xl border border-primary/20 bg-gradient-to-br from-primary/[0.03] to-primary/[0.08] p-6 dark:from-primary/[0.05] dark:to-primary/[0.12]">
  <div class="flex items-start gap-4">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-lg">🤖</span>
    <div>
      <p class="font-semibold text-zinc-900 dark:text-zinc-100">Sommelier AI</p>
      <p class="mt-1 text-sm text-muted dark:text-muted-dark">
        Próximamente podrás consultar recomendaciones personalizadas, maridajes inteligentes y
        una experiencia guiada para <strong class="text-zinc-900 dark:text-zinc-100">{productName}</strong>.
      </p>
      <span class="mt-3 inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-primary-light">
        Integración futura
      </span>
    </div>
  </div>
</div>
