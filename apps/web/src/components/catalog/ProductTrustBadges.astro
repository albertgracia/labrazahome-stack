---
export interface Props {
  badges: string[];
}

const { badges } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {badges.map(b => (
    <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:bg-primary/10 dark:text-primary-light">
      <span class="text-primary/60">✓</span>
      {b}
    </span>
  ))}
</div>
