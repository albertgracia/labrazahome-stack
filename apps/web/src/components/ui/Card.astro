---
export interface Props {
  variant?: 'default' | 'elevated' | 'highlight';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'border border-border bg-card dark:border-border-dark dark:bg-card-dark',
  elevated: 'border border-border bg-card shadow-sm dark:border-border-dark dark:bg-card-dark',
  highlight: 'border border-primary/20 bg-gradient-to-br from-primary/[0.03] to-primary/[0.08] dark:from-primary/[0.05] dark:to-primary/[0.12]',
};
---

<div class={`rounded-xl p-6 transition hover:shadow-lg ${variants[variant]} ${className ?? ''}`}>
  <slot />
</div>
