---
import type { AdminRoadmapItem } from '../../types/admin';

export interface Props {
  items: AdminRoadmapItem[];
}
const { items } = Astro.props;

const statusStyle = {
  completed: { dot: 'bg-emerald-500', line: 'bg-emerald-500/30', label: '✅' },
  active: { dot: 'bg-amber-500', line: 'bg-amber-500/30', label: '🟢' },
  pending: { dot: 'bg-border dark:bg-border-dark', line: 'bg-border dark:bg-border-dark', label: '⏳' },
};
---

<div class="rounded-xl border border-border bg-card p-6 dark:border-border-dark dark:bg-card-dark">
  <h3 class="text-base font-semibold">Roadmap Admin</h3>
  <p class="mt-1 text-xs text-muted dark:text-muted-dark">Progreso del Backoffice en el laboratorio.</p>
  <div class="mt-4 relative space-y-0">
    <div class="absolute left-[11px] top-3 h-[calc(100%-24px)] w-0.5 bg-border dark:bg-border-dark" />
    {items.map((item) => {
      const style = statusStyle[item.status];
      return (
        <div class="relative flex items-center gap-4 pb-5 last:pb-0">
          <div class={`z-10 h-3.5 w-3.5 shrink-0 rounded-full border-2 border-surface dark:border-surface-dark ${style.dot}`} />
          <div class="min-w-0 flex-1">
            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{item.phase}</span>
          </div>
          <span class="shrink-0 text-xs">{style.label}</span>
        </div>
      );
    })}
  </div>
</div>
