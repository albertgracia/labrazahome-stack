---
import type { BlockedProductItem } from '../../../types/admin';
import Card from '../../ui/Card.astro';

export interface Props {
  products: BlockedProductItem[];
}
const { products } = Astro.props;
---

<Card>
  <div class="flex items-center justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold">Productos bloqueados</h3>
      <p class="mt-1 text-xs text-muted dark:text-muted-dark">Productos que el Sommelier no debe recomendar.</p>
    </div>
    <button class="rounded-md px-3 py-1.5 text-xs font-medium text-primary hover:bg-primary/10 transition-colors" type="button">+ Bloquear</button>
  </div>
  <div class="mt-4 space-y-3">
    {products.map((p) => (
      <div class="rounded-lg border border-red-500/20 bg-red-500/5 p-3">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{p.name}</p>
            <p class="mt-0.5 text-xs text-muted dark:text-muted-dark">{p.reason}</p>
          </div>
          <button class="shrink-0 rounded-md px-2 py-1 text-[10px] font-medium text-primary hover:bg-primary/10 transition-colors" type="button">Desbloquear</button>
        </div>
      </div>
    ))}
  </div>
</Card>
