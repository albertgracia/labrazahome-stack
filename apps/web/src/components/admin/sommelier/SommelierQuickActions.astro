---
import Card from '../../ui/Card.astro';
---

<Card>
  <h3 class="text-base font-semibold">Acciones rápidas</h3>
  <p class="mt-1 text-xs text-muted dark:text-muted-dark">Operaciones frecuentes sobre el Sommelier.</p>
  <div class="mt-4 space-y-2">
    <button class="w-full rounded-lg border border-border bg-surface/50 px-4 py-2.5 text-left text-xs font-medium text-zinc-700 transition hover:bg-primary/5 dark:border-border-dark dark:bg-surface-dark/50 dark:text-zinc-300" type="button">
      🧪 Probar respuesta
    </button>
    <button class="w-full rounded-lg border border-border bg-surface/50 px-4 py-2.5 text-left text-xs font-medium text-zinc-700 transition hover:bg-primary/5 dark:border-border-dark dark:bg-surface-dark/50 dark:text-zinc-300" type="button">
      📋 Revisar logs
    </button>
    <button class="w-full rounded-lg border border-border bg-surface/50 px-4 py-2.5 text-left text-xs font-medium text-zinc-700 transition hover:bg-primary/5 dark:border-border-dark dark:bg-surface-dark/50 dark:text-zinc-300" type="button">
      🔄 Cambiar provider
    </button>
    <button class="w-full rounded-lg border border-border bg-surface/50 px-4 py-2.5 text-left text-xs font-medium text-zinc-700 transition hover:bg-primary/5 dark:border-border-dark dark:bg-surface-dark/50 dark:text-zinc-300" type="button">
      ⚙️ Configurar guardrails
    </button>
    <button class="w-full rounded-lg border border-border bg-surface/50 px-4 py-2.5 text-left text-xs font-medium text-zinc-700 transition hover:bg-primary/5 dark:border-border-dark dark:bg-surface-dark/50 dark:text-zinc-300" type="button">
      📊 Ver métricas
    </button>
  </div>
</Card>
