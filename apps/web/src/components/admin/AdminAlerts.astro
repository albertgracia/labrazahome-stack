---
import type { AdminAlert } from '../../types/admin';

export interface Props {
  alerts: AdminAlert[];
}
const { alerts } = Astro.props;

const severityStyles: Record<string, string> = {
  amber: 'border-l-amber-500 bg-amber-50/50 dark:bg-amber-950/10',
  emerald: 'border-l-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/10',
  indigo: 'border-l-indigo-500 bg-indigo-50/50 dark:bg-indigo-950/10',
};

const severityLabels: Record<string, string> = {
  amber: 'Media',
  emerald: 'Baja',
  indigo: 'Info',
};
---

<div class="rounded-xl border border-border bg-card p-6 dark:border-border-dark dark:bg-card-dark">
  <h3 class="text-base font-semibold">Alertas</h3>
  <p class="mt-1 text-xs text-muted dark:text-muted-dark">Incidencias y observaciones del ecosistema.</p>
  <div class="mt-4 space-y-3">
    {alerts.map((alert) => (
      <div class={`rounded-lg border-l-2 border-border p-3 ${severityStyles[alert.severityColor] || ''} dark:border-border-dark`}>
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{alert.title}</p>
            <p class="mt-0.5 text-xs text-muted dark:text-muted-dark">{alert.description}</p>
          </div>
          <span class="shrink-0 rounded-full border border-border px-2 py-0.5 text-[10px] font-medium text-muted dark:border-border-dark dark:text-muted-dark">
            {severityLabels[alert.severityColor] || alert.severity}
          </span>
        </div>
      </div>
    ))}
  </div>
</div>
