---
import type {
  AdminAIBatchStats,
  AdminAICapability,
  AdminAIGeneratedSample,
  AdminAIReviewStep,
  AdminAIWarning,
} from "../../types/admin";
import AIGeneratedSampleViewer from "./AIGeneratedSampleViewer.astro";

export interface Props {
  stats: AdminAIBatchStats;
  capabilities: AdminAICapability[];
  samples: AdminAIGeneratedSample[];
  workflow: AdminAIReviewStep[];
  warnings: AdminAIWarning[];
}

const { stats, capabilities, samples, workflow, warnings } = Astro.props;
---

<section class="rounded-xl border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-base font-semibold">AI Editorial Assistant</h2>
      <p class="mt-0.5 text-xs text-muted dark:text-muted-dark">
        Generación batch de contenido editorial vía Qwen 3.5 9B
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">
        Batch / Async
      </span>
      <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-[11px] font-medium text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300">
        Mock
      </span>
    </div>
  </div>

  <!-- Model info -->
  <div class="mt-4 flex flex-wrap gap-3 rounded-lg border border-border bg-card p-3 dark:border-border-dark dark:bg-card-dark">
    <div class="flex items-center gap-2 text-xs">
      <span class="font-medium text-muted dark:text-muted-dark">Modelo:</span>
      <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11px] dark:bg-zinc-800">qwen3.5-9b-deepseek-v4-flash</code>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-medium text-muted dark:text-muted-dark">Modo:</span>
      <span>Batch / Async</span>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-medium text-muted dark:text-muted-dark">Revisión humana:</span>
      <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">Requerida</span>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="font-medium text-muted dark:text-muted-dark">Producción:</span>
      <span class="rounded bg-red-100 px-1.5 py-0.5 text-[11px] font-medium text-red-700 dark:bg-red-900/30 dark:text-red-300">No activado</span>
    </div>
  </div>

  <!-- Batch stats -->
  <div class="mt-6">
    <h3 class="text-sm font-semibold">Última ejecución batch</h3>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold">{stats.productsProcessed}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">Productos</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold">{stats.fieldsGenerated}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">Campos</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold text-emerald-600">{stats.jsonValid}/{stats.fieldsGenerated}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">JSON válido</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold text-amber-600">{stats.timeouts}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">Timeouts</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold text-emerald-600">{stats.hallucinations}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">Alucinaciones</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold">{stats.avgQuality}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">Calidad</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold">{stats.avgB2B}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">B2B</div>
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-center dark:border-border-dark dark:bg-card-dark">
        <div class="text-lg font-bold">{stats.avgSEO}</div>
        <div class="text-[10px] text-muted dark:text-muted-dark">SEO</div>
      </div>
    </div>
  </div>

  <!-- Capabilities -->
  <div class="mt-6">
    <h3 class="text-sm font-semibold">Capacidades</h3>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {capabilities.map((cap) => (
        <div class="rounded-lg border border-border bg-card p-3 dark:border-border-dark dark:bg-card-dark">
          <div class="flex items-center gap-2">
            <span class="text-base">{cap.icon}</span>
            <span class="text-xs font-semibold">{cap.label}</span>
          </div>
          <p class="mt-1 text-[11px] leading-relaxed text-secondary dark:text-secondary-dark">
            {cap.description}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Generated samples -->
  <div class="mt-6">
    <h3 class="text-sm font-semibold">Resultados generados</h3>
    <p class="mt-0.5 text-xs text-muted dark:text-muted-dark">
      Contenido generado por IA batch para revisión editorial. No es tiempo real.
    </p>
    <div class="mt-3">
      <AIGeneratedSampleViewer samples={samples} />
    </div>
  </div>

  <!-- Review workflow -->
  <div class="mt-6">
    <h3 class="text-sm font-semibold">Workflow de revisión</h3>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {workflow.map((step) => (
        <div class="flex items-center gap-1.5">
          <span
            class:list={[
              "rounded-full px-2.5 py-0.5 text-[11px] font-medium",
              step.status === "done"
                ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300"
                : step.status === "current"
                  ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300"
                  : "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400",
            ]}
          >
            {step.step}
          </span>
          {workflow.indexOf(step) < workflow.length - 1 && (
            <span class="text-muted dark:text-muted-dark">→</span>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Human review badges -->
  <div class="mt-4 flex flex-wrap gap-2">
    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">
      ⏳ Needs Review
    </span>
    <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-[11px] font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
      ✅ Approved Mock
    </span>
    <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-[11px] font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
      ❌ Rejected Mock
    </span>
  </div>

  <!-- Warnings -->
  <div class="mt-6 space-y-2">
    {warnings.map((w) => (
      <div
        class:list={[
          "flex items-start gap-2 rounded-lg border p-3",
          w.type === "info"
            ? "border-blue-200 bg-blue-50 dark:border-blue-900/40 dark:bg-blue-950/20"
            : w.type === "warning"
              ? "border-amber-200 bg-amber-50 dark:border-amber-900/40 dark:bg-amber-950/20"
              : "border-red-200 bg-red-50 dark:border-red-900/40 dark:bg-red-950/20",
        ]}
      >
        <span class="mt-0.5 shrink-0 text-xs">
          {w.type === "info" ? "ℹ️" : w.type === "warning" ? "⚠️" : "🚫"}
        </span>
        <p class="text-xs leading-relaxed text-secondary dark:text-secondary-dark">
          {w.message}
        </p>
      </div>
    ))}
  </div>
</section>
