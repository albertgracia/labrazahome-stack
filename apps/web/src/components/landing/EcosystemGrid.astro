---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

export interface Product {
  icon: string;
  title: string;
  description: string;
  status: 'base' | 'completed' | 'development' | 'architecture' | 'design' | 'demo' | 'future';
}

export interface Props {
  products: Product[];
}

const statusConfig = {
  base: { badge: 'Plataforma base', variant: 'default' as const },
  completed: { badge: 'Completado', variant: 'success' as const },
  development: { badge: 'En desarrollo', variant: 'warning' as const },
  architecture: { badge: 'Arquitectura completa', variant: 'success' as const },
  design: { badge: 'En diseño', variant: 'default' as const },
  demo: { badge: 'Professional Platform Mock', variant: 'warning' as const },
  future: { badge: 'Futuro', variant: 'default' as const },
};

const { products } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center">
  <p class="text-sm font-medium uppercase tracking-[0.2em] text-primary">Ecosistema</p>
  <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Productos del laboratorio</h2>
  <p class="mt-4 text-lg text-balance text-muted dark:text-muted-dark">
    Cada producto nace como un experimento dentro del laboratorio. Se valida, se refina
    y se prepara para su integración controlada en el ecosistema real.
  </p>
</div>
<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    products.map((product, i) => {
      const config = statusConfig[product.status];
      const isLarge = i === 0;
      return (
        <Card class={isLarge ? 'sm:col-span-2 lg:col-span-3' : ''}>
          <div class="flex items-start gap-5">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-2xl">
              {product.icon}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3">
                <h3 class="text-lg font-semibold">{product.title}</h3>
                <Badge variant={config.variant}>{config.badge}</Badge>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted dark:text-muted-dark">{product.description}</p>
            </div>
          </div>
        </Card>
      );
    })
  }
</div>
