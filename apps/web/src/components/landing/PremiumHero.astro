---
import Button from '../ui/Button.astro';
---

<section class="relative isolate overflow-hidden">
  <!-- Imagen de fondo: Laguardia, viñedos y Sierra de Cantabria al atardecer -->
  <img
    src="/images/rioja-alavesa-hero.png"
    alt="Vista de Laguardia sobre los viñedos de la Rioja Alavesa con la Sierra de Cantabria al atardecer"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Overlays para legibilidad del texto -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/70 via-black/45 to-black/80"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/50 to-transparent"></div>

  <div class="section-padding">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="relative mx-auto max-w-4xl text-center">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-200">Rioja Alavesa · Laboratorio de innovación</p>
        <h1 class="mt-8 text-5xl font-extrabold tracking-tight text-white drop-shadow-lg sm:text-7xl lg:text-8xl">
          LabrazaHome<br />
          <span class="bg-gradient-to-r from-amber-200 via-amber-100 to-amber-300 bg-clip-text text-transparent">Labs</span>
        </h1>
        <p class="mx-auto mt-8 max-w-3xl text-lg leading-relaxed text-balance text-zinc-100 drop-shadow">
          Un laboratorio digital para construir la próxima generación de comercio,
          inteligencia artificial y operaciones para el sector agroalimentario premium.
        </p>
        <p class="mx-auto mt-6 max-w-3xl text-sm leading-relaxed text-balance text-zinc-200/90 drop-shadow">
          Desde Rioja Marketplace hasta Sommelier AI, estamos diseñando una plataforma
          modular para conectar productores, distribuidores y clientes con experiencias
          digitales de alto nivel.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="#ecosistema" size="lg">Explorar ecosistema</Button>
          <Button href="#roadmap" variant="secondary" size="lg">Ver roadmap</Button>
        </div>
      </div>

      <div class="mt-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-white/15 bg-white/10 p-6 backdrop-blur-md">
          <p class="text-3xl font-bold text-amber-200">5</p>
          <p class="mt-1 text-sm font-semibold text-white">Módulos en desarrollo</p>
          <p class="mt-1 text-xs text-zinc-200/80">Productos activos en el laboratorio</p>
        </div>
        <div class="rounded-xl border border-white/15 bg-white/10 p-6 backdrop-blur-md">
          <p class="text-3xl font-bold text-amber-200">100%</p>
          <p class="mt-1 text-sm font-semibold text-white">Stack moderno</p>
          <p class="mt-1 text-xs text-zinc-200/80">Astro, React, Fastify, Prisma, PostgreSQL</p>
        </div>
        <div class="rounded-xl border border-white/15 bg-white/10 p-6 backdrop-blur-md">
          <p class="text-3xl font-bold text-amber-200">AI</p>
          <p class="mt-1 text-sm font-semibold text-white">AI-ready</p>
          <p class="mt-1 text-xs text-zinc-200/80">Modelos open source + AI-LAB</p>
        </div>
        <div class="rounded-xl border border-white/15 bg-white/10 p-6 backdrop-blur-md">
          <p class="text-3xl font-bold text-amber-200">V+G</p>
          <p class="mt-1 text-sm font-semibold text-white">Pipeline integrado</p>
          <p class="mt-1 text-xs text-zinc-200/80">Vercel + GitHub CI/CD</p>
        </div>
      </div>
    </div>
  </div>
</section>
