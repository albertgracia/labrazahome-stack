---
import Button from '../ui/Button.astro';
---

<div class="mx-auto max-w-3xl text-center">
  <h2 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">
    El ecosistema LabrazaHome<br />está en construcción.
  </h2>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-balance text-muted dark:text-muted-dark">
    Estamos construyendo una plataforma modular para unir producto, tecnología
    e inteligencia artificial en una experiencia premium.
  </p>
  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <Button href="#roadmap" size="lg">Ver roadmap</Button>
    <Button href="#tecnologia" variant="secondary" size="lg">Explorar tecnología</Button>
  </div>
</div>
