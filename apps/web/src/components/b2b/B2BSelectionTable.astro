---
import type { B2BSelectionItem } from '../../types/b2b';

export interface Props {
  items: B2BSelectionItem[];
}
const { items } = Astro.props;

const statusColor: Record<string, string> = {
  "ready_for_quote": "text-emerald-400 border-emerald-500/20 bg-emerald-500/5",
  "draft": "text-amber-400 border-amber-500/20 bg-amber-500/5",
  "quote_prepared_mock": "text-blue-400 border-blue-500/20 bg-blue-500/5",
  "archived_mock": "text-zinc-400 border-zinc-500/20 bg-zinc-500/5",
};
---

<div>
  <h2 class="mb-4 text-lg font-semibold">Selección actual</h2>
  <div class="overflow-hidden rounded-xl border border-border dark:border-border-dark">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border bg-muted/30 dark:border-border-dark dark:bg-muted-dark/30">
          <th class="px-4 py-3 text-left font-medium text-muted dark:text-muted-dark">Producto</th>
          <th class="px-4 py-3 text-left font-medium text-muted dark:text-muted-dark">Cantidad</th>
          <th class="px-4 py-3 text-left font-medium text-muted dark:text-muted-dark">Uso</th>
          <th class="px-4 py-3 text-left font-medium text-muted dark:text-muted-dark">Estado</th>
        </tr>
      </thead>
      <tbody>
        {items.map((item) => {
          const status = item.status ?? "draft";
          const sc = statusColor[status] || "text-zinc-400 border-zinc-500/20 bg-zinc-500/5";
          return (
            <tr class="border-b border-border last:border-0 dark:border-border-dark">
              <td class="px-4 py-3 font-medium">{item.productName}</td>
              <td class="px-4 py-3 text-muted dark:text-muted-dark">{item.quantity} uds</td>
              <td class="px-4 py-3 text-muted dark:text-muted-dark">{item.useCase || "—"}</td>
              <td class="px-4 py-3"><span class={`rounded-full border px-2 py-0.5 text-[10px] font-medium ${sc}`}>{status}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
