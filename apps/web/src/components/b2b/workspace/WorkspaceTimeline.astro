---
import type { WorkspaceTimelineItem } from '../../../data/b2b/workspaceMock';

export interface Props {
  timeline: WorkspaceTimelineItem[];
}
const { timeline } = Astro.props;
---

<div>
  <h2 class="mb-4 text-lg font-semibold">Actividad reciente</h2>
  <div class="space-y-0">
    {timeline.map((t) => (
      <div class="flex items-start gap-3 border-b border-border py-3 last:border-0 dark:border-border-dark">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-sm">{t.icon}</span>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium">{t.action}</p>
          <p class="text-xs text-muted dark:text-muted-dark">{t.detail}</p>
        </div>
        <span class="shrink-0 text-xs text-muted dark:text-muted-dark">{t.time}</span>
      </div>
    ))}
  </div>
</div>
