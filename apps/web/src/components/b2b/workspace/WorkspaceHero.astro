---
import Badge from '../../ui/Badge.astro';
---

<div class="relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-card to-card/80 p-8 dark:border-border-dark dark:from-card-dark dark:to-card-dark/80">
  <div class="absolute right-0 top-0 h-64 w-64 translate-x-16 -translate-y-16 rounded-full bg-primary/[0.03] blur-3xl" />
  <div class="relative">
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant="warning">Mock Workspace</Badge>
      <span class="inline-flex items-center rounded-full border border-purple-500/20 bg-purple-500/5 px-2.5 py-0.5 text-xs font-medium text-purple-400">Lab mode</span>
      <Badge variant="warning">Datos simulados</Badge>
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Workspace Profesional</h1>
    <p class="mt-2 max-w-2xl text-sm text-muted dark:text-muted-dark">
      Centro de trabajo para gestionar selecciones, presupuestos y documentación.
    </p>
  </div>
</div>
