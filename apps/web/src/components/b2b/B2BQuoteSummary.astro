---
import type { B2BQuoteSummary } from '../../data/b2b/mockDashboard';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

export interface Props {
  summary: B2BQuoteSummary;
}
const { summary } = Astro.props;
---

<Card variant="highlight">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="font-semibold">Solicitud de presupuesto</h3>
      <div class="mt-2 flex flex-wrap gap-3">
        <span class="text-sm text-muted dark:text-muted-dark">{summary.selectedProducts} productos seleccionados</span>
        <span class="text-sm text-muted dark:text-muted-dark">·</span>
        <span class="text-sm text-muted dark:text-muted-dark">{summary.totalUnits}</span>
        <span class="text-sm text-muted dark:text-muted-dark">·</span>
        <span class="text-sm text-amber-400">{summary.conditions}</span>
      </div>
    </div>
    <Button variant="primary" size="sm">Preparar solicitud</Button>
  </div>
</Card>
