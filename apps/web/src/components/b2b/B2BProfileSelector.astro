---
import type { B2BProfessionalProfile } from '../../data/b2b/mockDashboard';
import Card from '../ui/Card.astro';

export interface Props {
  profiles: B2BProfessionalProfile[];
}
const { profiles } = Astro.props;
---

<div>
  <h2 class="mb-4 text-lg font-semibold">Perfil profesional</h2>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {profiles.map((p) => (
      <Card variant="default" class="cursor-pointer hover:border-primary/40">
        <div class="flex flex-col items-center text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-2xl">{p.icon}</span>
          <h3 class="mt-3 font-semibold text-sm">{p.name}</h3>
          <p class="mt-1 text-xs text-muted dark:text-muted-dark leading-relaxed">{p.description}</p>
          <span class="mt-2 text-[10px] font-medium uppercase tracking-wider text-primary/60">{p.typicalUse}</span>
        </div>
      </Card>
    ))}
  </div>
</div>
