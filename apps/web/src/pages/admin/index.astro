---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import AdminDashboardHero from '../../components/admin/AdminDashboardHero.astro';
import AdminKpiStrip from '../../components/admin/AdminKpiStrip.astro';
import AdminOperationalOverview from '../../components/admin/AdminOperationalOverview.astro';
import AdminCatalogReview from '../../components/admin/AdminCatalogReview.astro';
import AdminB2BPipeline from '../../components/admin/AdminB2BPipeline.astro';
import AdminSommelierGovernance from '../../components/admin/AdminSommelierGovernance.astro';
import AdminIntegrationsStatus from '../../components/admin/AdminIntegrationsStatus.astro';
import AdminAlerts from '../../components/admin/AdminAlerts.astro';
import AdminRecentActivity from '../../components/admin/AdminRecentActivity.astro';
import AdminRoadmap from '../../components/admin/AdminRoadmap.astro';
import AdminLabNotice from '../../components/admin/AdminLabNotice.astro';
import {
  adminKpis,
  catalogReviewItems,
  b2bPipelineItems,
  sommelierGovernanceMetrics,
  integrationStatusItems,
  adminAlerts,
  adminRecentActivity,
  adminRoadmapData,
} from '../../data/admin/adminDashboard';
---

<Layout
  title="Backoffice Admin v2 — Dashboard operativo | LabrazaHome Labs"
  description="Centro operativo mock del Backoffice Admin v2. KPIs, revisión de catálogo, pipeline B2B, governance Sommelier y estado de integraciones."
  canonical="/admin/"
>
  <Section background="muted" class="pb-0">
    <Container>
      <AdminLabNotice />
      <div class="mt-4">
        <AdminDashboardHero />
      </div>
    </Container>
  </Section>

  <Section class="pt-6">
    <Container>
      <AdminKpiStrip kpis={adminKpis} />
    </Container>
  </Section>

  <Section class="pb-0 pt-2">
    <Container>
      <div class="flex flex-wrap items-center gap-3 rounded-xl border border-border bg-card p-4 dark:border-border-dark dark:bg-card-dark">
        <span class="text-sm text-muted">Herramientas:</span>
        <a href="/admin/contenido" class="inline-flex items-center gap-1.5 rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary transition hover:bg-primary/20">
          📝 Content Manager
        </a>
      </div>
    </Container>
  </Section>

  <Section background="muted">
    <Container>
      <AdminOperationalOverview>
        <div slot="main">
          <AdminCatalogReview items={catalogReviewItems} />
          <div class="mt-6">
            <AdminB2BPipeline items={b2bPipelineItems} />
          </div>
          <div class="mt-6">
            <AdminSommelierGovernance metrics={sommelierGovernanceMetrics} />
          </div>
          <div class="mt-6">
            <AdminRecentActivity items={adminRecentActivity} />
          </div>
        </div>
        <div slot="sidebar">
          <AdminAlerts alerts={adminAlerts} />
          <div class="mt-6">
            <AdminRoadmap items={adminRoadmapData} />
          </div>
          <div class="mt-6">
            <AdminIntegrationsStatus items={integrationStatusItems} />
          </div>
        </div>
      </AdminOperationalOverview>
    </Container>
  </Section>
</Layout>
