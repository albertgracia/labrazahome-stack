---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import WorkspaceHero from '../../components/b2b/workspace/WorkspaceHero.astro';
import WorkspaceProfile from '../../components/b2b/workspace/WorkspaceProfile.astro';
import WorkspaceSelections from '../../components/b2b/workspace/WorkspaceSelections.astro';
import WorkspaceQuotes from '../../components/b2b/workspace/WorkspaceQuotes.astro';
import WorkspaceDocuments from '../../components/b2b/workspace/WorkspaceDocuments.astro';
import WorkspaceSommelier from '../../components/b2b/workspace/WorkspaceSommelier.astro';
import WorkspaceTimeline from '../../components/b2b/workspace/WorkspaceTimeline.astro';
import WorkspaceNextSteps from '../../components/b2b/workspace/WorkspaceNextSteps.astro';
import {
  workspaceProfile,
  workspaceProfiles,
  getWorkspaceSelections,
  workspaceQuotes,
  workspaceDocuments,
  workspaceTimeline,
  workspaceSommelierRecommendations,
} from '../../data/b2b/workspaceMock';

const workspaceSelections = getWorkspaceSelections();
---

<Layout
  title="Workspace Profesional B2B | LabrazaHome Labs"
  description="Centro de trabajo profesional para gestionar selecciones, presupuestos y documentación B2B."
  canonical="/b2b/workspace/"
>
  <Section background="muted">
    <Container>
      <WorkspaceHero />
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="grid gap-6 lg:grid-cols-3">

        <!-- COLUMNA IZQUIERDA (2/3) -->
        <div class="space-y-6 lg:col-span-2">

          <!-- Perfil profesional -->
          <Card variant="default">
            <WorkspaceProfile profiles={workspaceProfiles} active={workspaceProfile} />
          </Card>

          <!-- Mis selecciones -->
          <Card variant="default">
            <WorkspaceSelections selections={workspaceSelections} />
          </Card>

          <!-- Mis presupuestos -->
          <Card variant="default">
            <WorkspaceQuotes quotes={workspaceQuotes} />
          </Card>

        </div>

        <!-- COLUMNA DERECHA (1/3) -->
        <div class="space-y-6">

          <!-- Actividad reciente -->
          <Card variant="default">
            <WorkspaceTimeline timeline={workspaceTimeline} />
          </Card>

          <!-- Sommelier B2B -->
          <Card variant="default">
            <WorkspaceSommelier recommendations={workspaceSommelierRecommendations} />
          </Card>

          <!-- Documentos -->
          <Card variant="default">
            <WorkspaceDocuments documents={workspaceDocuments} />
          </Card>

          <!-- Próximos pasos -->
          <Card variant="default">
            <WorkspaceNextSteps />
          </Card>

        </div>

      </div>
    </Container>
  </Section>

  <Section background="muted">
    <Container>
      <div class="mx-auto max-w-2xl rounded-xl border border-amber-500/20 bg-amber-500/5 p-8 text-center">
        <p class="text-lg font-semibold">🧪 Aviso de laboratorio</p>
        <p class="mt-3 text-sm leading-relaxed text-muted dark:text-muted-dark">
          Este workspace muestra datos simulados. No hay selecciones reales, presupuestos reales ni documentación comercial real.<br />
          Los datos persistirán únicamente en tu navegador mientras dure la sesión de laboratorio.
        </p>
      </div>
    </Container>
  </Section>
</Layout>
