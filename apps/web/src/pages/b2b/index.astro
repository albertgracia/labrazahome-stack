---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import B2BDashboardHero from '../../components/b2b/B2BDashboardHero.astro';
import B2BKpiStrip from '../../components/b2b/B2BKpiStrip.astro';
import B2BProfileSelector from '../../components/b2b/B2BProfileSelector.astro';
import B2BSommelierHints from '../../components/b2b/B2BSommelierHints.astro';
import B2BDocumentCards from '../../components/b2b/B2BDocumentCards.astro';
import B2BActivityFeed from '../../components/b2b/B2BActivityFeed.astro';
import B2BSelectionManager from '../../components/b2b/B2BSelectionManager';

import {
  b2bKpis,
  professionalProfiles,
  getB2BRecommendedProducts,
  documents,
  recentActivity,
  sommelierHints,
} from '../../data/b2b/mockDashboard';

const recommendedProducts = getB2BRecommendedProducts();
---

<Layout
  title="Portal B2B v2 — Dashboard profesional | LabrazaHome Labs"
  description="Panel profesional para restaurantes, tiendas gourmet, distribuidores y hoteles. Catálogo, selecciones y presupuestos B2B."
  canonical="/b2b/"
>
  <!-- HERO -->
  <Section background="muted">
    <Container>
      <B2BDashboardHero
        title="Portal B2B v2"
        subtitle="Panel profesional para explorar catálogo, preparar selecciones y solicitar presupuestos."
      />
    </Container>
  </Section>

  <!-- KPI STRIP -->
  <Section>
    <Container>
      <B2BKpiStrip kpis={b2bKpis} />
    </Container>
  </Section>

  <!-- PERFIL PROFESIONAL -->
  <Section background="muted">
    <Container>
      <B2BProfileSelector profiles={professionalProfiles} />
    </Container>
  </Section>

  <!-- DASHBOARD LAYOUT: 3 COLUMNAS -->
  <Section>
    <Container>
      <div class="grid gap-6 lg:grid-cols-3">

        <!-- COLUMNA IZQUIERDA (2/3): Resumen cuenta + Actividad + Catálogo/Selección interactivo -->
        <div class="space-y-6 lg:col-span-2">
          <!-- Resumen cuenta mock -->
          <Card variant="default">
            <div class="flex items-start justify-between">
              <div>
                <h2 class="text-lg font-semibold">Resumen de cuenta</h2>
                <p class="text-sm text-muted dark:text-muted-dark">Perfil: Restaurante · Estado comercial: Simulado</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <span class="rounded-full border border-zinc-500/20 bg-zinc-500/5 px-2.5 py-0.5 text-xs text-zinc-400">Condiciones: Pendientes</span>
                  <span class="rounded-full border border-zinc-500/20 bg-zinc-500/5 px-2.5 py-0.5 text-xs text-zinc-400">Descuento: —</span>
                  <span class="rounded-full border border-zinc-500/20 bg-zinc-500/5 px-2.5 py-0.5 text-xs text-zinc-400">Crédito: Simulado</span>
                </div>
              </div>
              <Badge variant="warning">Mock</Badge>
            </div>
          </Card>

          <!-- Actividad reciente -->
          <Card variant="default">
            <B2BActivityFeed activities={recentActivity} />
          </Card>

          <!-- Catálogo + Selección interactivo (React) -->
          <B2BSelectionManager products={recommendedProducts} client:load />
        </div>

        <!-- COLUMNA DERECHA (1/3): Sommelier + Documentos -->
        <div class="space-y-6">
          <!-- Sommelier B2B -->
          <Card variant="default">
            <B2BSommelierHints hints={sommelierHints} />
          </Card>

          <!-- Documentos -->
          <Card variant="default">
            <B2BDocumentCards documents={documents} />
            <div class="mt-4 text-center">
              <a
                href="/b2b/documentos"
                class="inline-flex items-center gap-1 text-xs font-medium text-primary transition hover:text-primary-dark"
              >
                Ir al Centro de Documentos →
              </a>
            </div>
          </Card>
        </div>

      </div>
    </Container>
  </Section>

  <!-- AVISO LABORATORIO -->
  <Section background="muted">
    <Container>
      <div class="mx-auto max-w-2xl rounded-xl border border-amber-500/20 bg-amber-500/5 p-8 text-center">
        <p class="text-lg font-semibold">🧪 Aviso de laboratorio</p>
        <p class="mt-3 text-sm leading-relaxed text-muted dark:text-muted-dark">
          No hay precios reales, stock real ni condiciones comerciales reales.<br />
          Este panel muestra datos simulados para validar la experiencia profesional B2B.<br />
          Los datos reales llegarán en fases posteriores con integración de backend.
        </p>
      </div>
    </Container>
  </Section>
</Layout>
