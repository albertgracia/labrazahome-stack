---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import PremiumHero from '../components/landing/PremiumHero.astro';
import EcosystemGrid from '../components/landing/EcosystemGrid.astro';
import ArchitecturePreview from '../components/landing/ArchitecturePreview.astro';
import RoadmapTimeline from '../components/landing/RoadmapTimeline.astro';
import VisionSection from '../components/landing/VisionSection.astro';
import FinalCTA from '../components/landing/FinalCTA.astro';

const products = [
  {
    icon: '🏠',
    title: 'Rioja Marketplace',
    description: 'Plataforma comercial actual y base operativa del ecosistema. Conecta bodegas, distribuidores y clientes en la D.O.Ca Rioja.',
    status: 'base' as const,
  },
  {
    icon: '🍷',
    title: 'Sommelier AI v2',
    description: 'Asistente inteligente conversacional con recomendaciones, maridajes, flujos guiados y base de conocimiento enriquecida.',
    status: 'completed' as const,
  },
  {
    icon: '📦',
    title: 'Catálogo Premium v2',
    description: 'Experiencia editorial y visual para vinos, aceites, mieles y productos seleccionados del sector agroalimentario premium.',
    status: 'completed' as const,
  },
  {
    icon: '🏢',
    title: 'Portal B2B v2',
    description: 'Plataforma profesional mock con dashboard, workspace, document center, selección interactiva y presupuestos simulados.',
    status: 'demo' as const,
  },
  {
    icon: '🛠️',
    title: 'Backoffice Admin v2',
    description: 'Dashboard operativo mock con KPIs, revisión de catálogo, pipeline B2B, governance Sommelier y alertas.',
    status: 'mock' as const,
  },
];

const roadmapItems = [
  { phase: 'Fase 1', title: 'Base técnica', description: 'Infraestructura fundamental: monorepo, Astro, Fastify, Prisma, PostgreSQL.', status: 'completed' as const },
  { phase: 'Fase 1', title: 'Landing LabrazaHome Labs', description: 'Presencia digital del laboratorio con identidad corporativa premium.', status: 'completed' as const },
  { phase: 'Fase 1', title: 'Design System', description: 'Sistema de diseño unificado para todos los productos del laboratorio.', status: 'completed' as const },
  { phase: 'Fase 2', title: 'Catálogo Premium v2', description: '11 productos, 5 categorías, fichas técnicas, ratings y base de conocimiento.', status: 'completed' as const },
  { phase: 'Fase 2', title: 'Sommelier AI v2', description: 'UI conversacional, motor de recomendaciones, flujos guiados y conocimiento enriquecido.', status: 'completed' as const },
  { phase: 'Fase 3', title: 'Portal B2B v2', description: 'Plataforma profesional mock: dashboard, quote flow, workspace cliente y document center con filtros y detalle.', status: 'demo' as const },
  { phase: 'Fase 3', title: 'Backoffice Admin v2', description: 'Dashboard operativo mock con KPIs, revisión de catálogo, pipeline B2B y Sommelier governance.', status: 'mock' as const },
  { phase: 'Fase 4', title: 'IA Real', description: 'Integración controlada con modelos locales (LM Studio) y AI-LAB Gateway.', status: 'next' as const },
  { phase: 'Fase 5', title: 'Integración Rioja Marketplace', description: 'Conexión controlada y documentada con la plataforma de producción.', status: 'future' as const },
];
---

<Layout
  title="LabrazaHome Labs — Laboratorio digital agroalimentario premium"
  description="Laboratorio digital para construir Sommelier AI, Portal B2B, Catálogo Premium y nuevas experiencias para el ecosistema LabrazaHome."
  canonical="/"
>
  <PremiumHero />

  <Section id="ecosistema" background="muted">
    <Container>
      <EcosystemGrid products={products} />
    </Container>
  </Section>

  <Section id="tecnologia">
    <Container>
      <ArchitecturePreview />
    </Container>
  </Section>

  <Section id="vision" background="muted">
    <Container>
      <VisionSection />
    </Container>
  </Section>

  <Section id="roadmap">
    <Container>
      <RoadmapTimeline items={roadmapItems} />
    </Container>
  </Section>

  <Section id="contacto" background="muted" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--color-primary)_0%,_transparent_60%)] opacity-5 dark:opacity-10" />
    <Container class="relative">
      <FinalCTA />
    </Container>
  </Section>
</Layout>
