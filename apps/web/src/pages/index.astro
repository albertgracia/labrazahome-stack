---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import PremiumHero from '../components/landing/PremiumHero.astro';
import EcosystemGrid from '../components/landing/EcosystemGrid.astro';
import ArchitecturePreview from '../components/landing/ArchitecturePreview.astro';
import RoadmapTimeline from '../components/landing/RoadmapTimeline.astro';
import VisionSection from '../components/landing/VisionSection.astro';
import FinalCTA from '../components/landing/FinalCTA.astro';

const products = [
  {
    icon: '🏠',
    title: 'Rioja Marketplace',
    description: 'Plataforma comercial actual y base operativa del ecosistema. Conecta bodegas, distribuidores y clientes en la D.O.Ca Rioja.',
    status: 'base' as const,
  },
  {
    icon: '🍷',
    title: 'Sommelier AI v2',
    description: 'Asistente inteligente para recomendaciones, maridajes y experiencia de compra guiada basada en perfiles y preferencias.',
    status: 'development' as const,
  },
  {
    icon: '📦',
    title: 'Catálogo Premium v2',
    description: 'Experiencia editorial y visual para vinos, aceites, mieles y productos seleccionados del sector agroalimentario premium.',
    status: 'development' as const,
  },
  {
    icon: '🏢',
    title: 'Portal B2B v2',
    description: 'Herramientas para profesionales, distribuidores, bodegas y operaciones comerciales del ecosistema LabrazaHome.',
    status: 'design' as const,
  },
  {
    icon: '🛠️',
    title: 'Backoffice Admin v2',
    description: 'Panel operativo avanzado para gestión, analítica y control interno del ecosistema digital LabrazaHome.',
    status: 'design' as const,
  },
];

const roadmapItems = [
  { phase: 'Fase 1', title: 'Base técnica', description: 'Infraestructura fundamental: monorepo, Astro, Fastify, Prisma, PostgreSQL.', status: 'completed' as const },
  { phase: 'Fase 1', title: 'Landing LabrazaHome Labs', description: 'Presencia digital del laboratorio con identidad corporativa premium.', status: 'completed' as const },
  { phase: 'Fase 1', title: 'Design System', description: 'Sistema de diseño unificado para todos los productos del laboratorio.', status: 'completed' as const },
  { phase: 'Fase 2', title: 'Catálogo Premium v2', description: 'Experiencia editorial y visual para productos agroalimentarios selectos.', status: 'in-progress' as const },
  { phase: 'Fase 2', title: 'Sommelier AI v2', description: 'Asistente inteligente con recomendaciones y maridaje basado en IA.', status: 'next' as const },
  { phase: 'Fase 3', title: 'Portal B2B v2', description: 'Herramientas comerciales para profesionales y distribuidores del sector.', status: 'future' as const },
  { phase: 'Fase 3', title: 'Backoffice Admin v2', description: 'Panel de administración y analítica para la gestión del ecosistema.', status: 'future' as const },
  { phase: 'Fase 4', title: 'Integración Rioja Marketplace', description: 'Conexión controlada y documentada con la plataforma de producción.', status: 'future' as const },
];
---

<Layout
  title="LabrazaHome Labs — Laboratorio digital agroalimentario premium"
  description="Laboratorio digital para construir Sommelier AI, Portal B2B, Catálogo Premium y nuevas experiencias para el ecosistema LabrazaHome."
  canonical="/"
>
  <PremiumHero />

  <Section id="ecosistema" background="muted">
    <Container>
      <EcosystemGrid products={products} />
    </Container>
  </Section>

  <Section id="tecnologia">
    <Container>
      <ArchitecturePreview />
    </Container>
  </Section>

  <Section id="vision" background="muted">
    <Container>
      <VisionSection />
    </Container>
  </Section>

  <Section id="roadmap">
    <Container>
      <RoadmapTimeline items={roadmapItems} />
    </Container>
  </Section>

  <Section id="contacto" background="muted" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--color-primary)_0%,_transparent_60%)] opacity-5 dark:opacity-10" />
    <Container class="relative">
      <FinalCTA />
    </Container>
  </Section>
</Layout>
