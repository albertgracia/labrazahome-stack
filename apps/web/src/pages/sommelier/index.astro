---
import Layout from '../../layouts/Layout.astro';
import SommelierChat from '../../components/sommelier/SommelierChat.tsx';

const quickPrompts = [
  { icon: '🍷', label: 'Vino para carnes rojas', query: '¿Qué vino recomiendas para carnes rojas?' },
  { icon: '🧀', label: 'Maridaje para quesos curados', query: 'Busco un maridaje para quesos curados' },
  { icon: '🎁', label: 'Regalo gastronómico premium', query: '¿Qué me recomiendas para un regalo gastronómico premium?' },
  { icon: '🍯', label: 'Mejor miel para desayuno', query: '¿Cuál es la mejor miel para el desayuno?' },
  { icon: '🫒', label: 'Aceite premium para cocina diaria', query: 'Recomiéndame un aceite premium para cocina diaria' },
];
---

<Layout
  title="Sommelier AI v2 — Asistente Inteligente | LabrazaHome Labs"
  description="Sommelier AI v2 es el asistente inteligente conversacional de LabrazaHome Labs. Recomendaciones, maridajes y explicaciones basadas en el Catálogo Premium v2."
  canonical="/sommelier"
>
  <!-- Background particles -->
  <div class="particles-bg" aria-hidden="true">
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div>
  </div>

  <!-- Hero Premium -->
  <section class="relative z-10 flex flex-col items-center px-4 pt-20 pb-16 text-center sm:pt-28 sm:pb-20">
    <div class="animate-blur-in">
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-4 py-1.5 text-xs font-medium tracking-wide text-emerald-400 uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        Conversacional · Recomendaciones · Maridajes
      </span>
    </div>

    <h1 class="mt-8 animate-blur-in" style="animation-delay: 150ms">
      <span class="block text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="inline-block animate-fade-in-up" style="animation-delay: 200ms">Tu</span>{' '}
        <span class="inline-block animate-fade-in-up" style="animation-delay: 300ms">sumiller</span>{' '}
        <span class="inline-block animate-fade-in-up" style="animation-delay: 400ms">personal</span>
      </span>
      <span class="mt-2 block text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="inline-block animate-fade-in-up" style="animation-delay: 500ms">con</span>{' '}
        <span class="inline-block animate-fade-in-up gradient-text" style="animation-delay: 600ms">inteligencia</span>{' '}
        <span class="inline-block animate-fade-in-up" style="animation-delay: 700ms">artificial</span>
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-zinc-400 sm:text-xl animate-fade-in-up" style="animation-delay: 800ms">
      Explora, aprende y descubre los mejores productos del Catálogo Premium v2
      <br class="hidden sm:inline" />
      con la guía de un sommelier experto impulsado por IA.
    </p>
  </section>

  <!-- Quick Prompts Premium -->
  <section class="relative z-10 px-4 pb-16">
    <div class="mx-auto max-w-4xl">
      <p class="mb-6 text-center text-sm font-medium tracking-wide text-zinc-500 uppercase">
        Prueba estas sugerencias
      </p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
        {quickPrompts.map((prompt, i) => (
          <button
            key={i}
            onclick={`document.querySelector('input[placeholder*="Pregunta"]').value = ${JSON.stringify(prompt.query)}; document.querySelector('input[placeholder*="Pregunta"]').form?.requestSubmit?.()`}
            class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 px-4 py-4 text-center transition-all duration-300 hover:border-indigo-500/50 hover:bg-white/10 hover:shadow-[0_0_30px_-5px_rgba(99,102,241,0.3)]"
            style={`animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: ${900 + i * 100}ms`}
          >
            <div class="mb-2 text-2xl transition-transform duration-300 group-hover:scale-110">{prompt.icon}</div>
            <div class="text-xs font-medium leading-tight text-zinc-300 transition-colors duration-300 group-hover:text-white">
              {prompt.label}
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Chat Premium -->
  <section class="relative z-10 px-4 pb-24">
    <div class="mx-auto max-w-4xl">
      <div
        class="overflow-hidden rounded-2xl border border-white/10 transition-shadow duration-500 hover:shadow-[0_0_60px_-15px_rgba(99,102,241,0.15)]"
        style="background: rgba(9, 9, 11, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
      >
        <SommelierChat client:load />
      </div>
      <p class="mt-4 text-center text-xs text-zinc-600">
        Modo laboratorio — Las respuestas son simuladas para validación de diseño.{' '}
        <a href="/catalogo" class="text-indigo-400 underline transition-colors hover:text-indigo-300">Explorar Catálogo Premium</a>
      </p>
    </div>
  </section>
</Layout>
