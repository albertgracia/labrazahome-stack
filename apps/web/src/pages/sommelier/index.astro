---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import SommelierChat from '../../components/sommelier/SommelierChat.tsx';
---

<Layout
  title="Sommelier AI v2 — Asistente Inteligente | LabrazaHome Labs"
  description="Sommelier AI v2 es el asistente inteligente conversacional de LabrazaHome Labs. Recomendaciones, maridajes y explicaciones basadas en el Catálogo Premium v2."
  canonical="/sommelier"
>
  <Section>
    <Container width="narrow">
      <div class="flex flex-col items-center text-center">
        <Badge variant="warning">En fase de integración</Badge>
        <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">
          Sommelier AI <span class="gradient-text">v2</span>
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">
          Asistente inteligente para recomendar, explicar y maridar productos del Catálogo Premium v2.
        </p>
      </div>
    </Container>
  </Section>

  <Section background="muted">
    <Container>
      <div class="grid gap-8 md:grid-cols-3">
        <Card>
          <div class="mb-4 text-4xl">🍷</div>
          <h3 class="text-lg font-semibold">Maridaje Inteligente</h3>
          <p class="mt-2 text-sm text-muted">
            Recomendaciones de vino según tu comida, con explicaciones de por qué cada
            variedad armoniza con cada plato.
          </p>
        </Card>

        <Card>
          <div class="mb-4 text-4xl">🎯</div>
          <h3 class="text-lg font-semibold">Recomendación Personalizada</h3>
          <p class="mt-2 text-sm text-muted">
            Encuentra el producto ideal para cada ocasión: cena romántica, regalo
            corporativo, celebración familiar.
          </p>
        </Card>

        <Card>
          <div class="mb-4 text-4xl">📖</div>
          <h3 class="text-lg font-semibold">Explicación de Producto</h3>
          <p class="mt-2 text-sm text-muted">
            Conoce la historia, las notas de cata, los maridajes y el origen de cada
            producto con profundidad editorial.
          </p>
        </Card>
      </div>
    </Container>
  </Section>

  <Section>
    <Container width="narrow">
      <div class="rounded-xl border border-border bg-card p-4 md:p-8 dark:border-border-dark dark:bg-card-dark">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Chat Sommelier AI</h2>
          <p class="text-muted">Interactúa con nuestro asistente inteligente para descubrir productos.</p>
        </div>
        
        <div class="relative">
          <SommelierChat client:load />
        </div>
      </div>
    </Container>
  </Section>

  <Section background="muted">
    <Container width="narrow">
      <div class="rounded-xl border border-border bg-card p-8 text-center dark:border-border-dark dark:bg-card-dark">
        <Badge variant="warning">Modo laboratorio</Badge>
        <p class="mt-4 text-sm text-muted">
          Esta interfaz es un prototipo de UX. Las respuestas son simuladas para validación de diseño.
        </p>
        <p class="mt-2 text-sm text-muted">
          Mientras tanto, puedes explorar el <a href="/catalogo" class="text-primary underline">Catálogo Premium v2</a>.
        </p>
      </div>
    </Container>
  </Section>
</Layout>
