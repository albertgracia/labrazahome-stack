# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stack-2026?schema=public"

# API
API_PORT=8080
WEB_PORT=4321
PUBLIC_SITE_URL="http://localhost:4321"

# Sommelier AI — Frontend API mode
# "mock" (safe for Vercel/production) uses frontend mock engine
# "api" requires Fastify backend running locally
PUBLIC_SOMMELIER_API_MODE=mock
PUBLIC_SOMMELIER_API_URL=http://localhost:8080

# Sommelier AI Backend Provider — LM Studio
# Set SOMMELIER_PROVIDER=lmstudio to use LM Studio for real LLM responses
# LM Studio runs at http://192.168.1.250:1234 (lab) or http://127.0.0.1:1234 (local)
# Models: llama-3.2-1b-instruct (chat), moondream2-20250414 (vision — future)
# Frontend NEVER calls LM Studio directly — only via Fastify backend
SOMMELIER_PROVIDER=mock
LMSTUDIO_BASE_URL=http://192.168.1.250:1234/v1
LMSTUDIO_MODEL=llama-3.2-1b-instruct
SOMMELIER_TIMEOUT_MS=30000

# Sommelier AI Backend Provider (future — AI-LAB)
AILAB_BASE_URL=http://127.0.0.1:8008/v1
AILAB_MODEL=ailab-router/auto
AILAB_TIMEOUT_MS=45000
AILAB_TRACE_ENABLED=true
